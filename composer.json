{
    "name": "youvision/think-httper",
    "description": "基于 php-curl-class 的 ThinkPHP 8 HTTP 客户端",
    "type": "library",
    "keywords": [
        "thinkphp",
        "http",
        "curl",
        "client",
        "php-curl-class"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "php-curl-class/php-curl-class": "^13.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "topthink/framework": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkHttper\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkHttper\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkHttper\\Service"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "topthink/think-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
